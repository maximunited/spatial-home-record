# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# private user blobs (auth-gated via /api/blobs) — never commit personal media
/.data/
# legacy path — keep ignored if old local trees remain
/public/uploads/**
!/public/uploads/.gitkeep
!/public/uploads/README.md

# personal apartment / private media — never commit
*.p12
/public/imports/**
!/public/imports/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
