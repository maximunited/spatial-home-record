{
  "name": "spatial-home-record",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run tests/projects.integration.test.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed-living-room-stub.ts",
    "seed:apt54-capture": "tsx scripts/seed-apt54-current-capture.ts",
    "import:apt54": "tsx scripts/import-apartment-54.ts",
    "cad:dwg": "node scripts/cad/dwg-to-underlay.mjs",
    "cad:dxf": "python scripts/cad/dxf-to-underlay.py",
    "cad:apt54": "node scripts/cad/dwg-to-underlay.mjs --apt54 && python scripts/cad/dxf-to-underlay.py --apt54",
    "cad:apply-walls": "tsx scripts/apply-cad-walls.ts",
    "cad:apply-rooms": "tsx scripts/apply-cad-rooms.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.24",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
