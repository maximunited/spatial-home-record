# Postgres (Neon pooled URL or any Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Clerk (optional — when set, all non-public routes + private blobs require sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Explicit local-dev bypass for private uploads (.data/uploads + /api/blobs).
# Required when Clerk keys are unset. Never enable on a shared/public host.
ALLOW_UNAUTHENTICATED_UPLOADS=1

# S3-compatible object storage (pass 1: schema pointers only)
BLOB_ENDPOINT=
BLOB_BUCKET=
BLOB_ACCESS_KEY_ID=
BLOB_SECRET_ACCESS_KEY=
BLOB_REGION=auto

# Live Home Assistant sync (read-only). Never commit real tokens.
# Used by GET /api/projects/:id/ha-sync — not stored in the database.
HA_BASE_URL=http://homeassistant.local:8123
HA_ACCESS_TOKEN=
