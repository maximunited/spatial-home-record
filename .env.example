# Postgres (Neon pooled URL or any Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Clerk (optional — leave unset for local/dev bypass)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# S3-compatible object storage (pass 1: schema pointers only)
BLOB_ENDPOINT=
BLOB_BUCKET=
BLOB_ACCESS_KEY_ID=
BLOB_SECRET_ACCESS_KEY=
BLOB_REGION=auto
